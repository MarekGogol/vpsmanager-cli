# Preferred: docker compose up -d --build && docker compose exec vpsmanager bash
# Plain docker alternative:
docker build . -t vpsmanager
docker run --cap-add=SYS_ADMIN --security-opt apparmor:unconfined \
            -d \
            --name vpsmanager \
            -p 8000:80 \
            -p 8443:443 \
            -p 2200:22 \
            -v "$(pwd)":/root/vpsmanager \
            vpsmanager
docker exec -it vpsmanager bash
